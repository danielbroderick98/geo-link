<%# Reuse Geo Link's existing background and full-height layout. %>
<div class="geo-home min-vh-100">
  <header class="border-bottom border-secondary">
    <nav class="container py-4 d-flex justify-content-between align-items-center"
         aria-label="Admin navigation">

      <%# Link the Geo Link branding to the homepage. %>
      <%= link_to root_path,
          class: "fs-3 fw-bold text-decoration-none text-light" do %>
        Geo<span class="geo-accent">Link</span>
      <% end %>

      <span class="badge rounded-pill geo-badge px-3 py-2">
        Admin workspace
      </span>
    </nav>
  </header>

  <main class="container py-5">
    <%# Display confirmation after successfully adding a participant. %>
    <% if flash[:notice].present? %>
      <div class="alert alert-success" role="status">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <div class="mb-4">
      <%= link_to "← Back to home", root_path,
          class: "geo-accent text-decoration-none small" %>
    </div>

    <%# Bootstrap allows the heading and badge to wrap on small screens. %>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
      <div>
        <p class="geo-accent small fw-bold text-uppercase mb-2">
          Treaty participation
        </p>

        <h1 class="display-6 fw-bold">Manage treaty participants</h1>

        <p class="geo-muted mb-0">
          Connect countries to the treaties they participate in.
        </p>
      </div>

      <span class="badge rounded-pill geo-badge px-3 py-2">
        Participant administration
      </span>
    </div>

    <%# Display two columns on wide screens and stack them on smaller screens. %>
    <div class="row g-4">
      <div class="col-xl-4">
        <section class="card geo-card rounded-4">
          <div class="card-body p-4">
            <h2 class="h4 mb-2">Add a participant</h2>

            <p class="geo-muted small mb-4">
              Choose a treaty and a participating country.
            </p>

            <%# Render the dropdown form. %>
            <%= render "form", treaty_participant: @treaty_participant %>
          </div>
        </section>
      </div>

      <div class="col-xl-8">
        <section class="card geo-card rounded-4">
          <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
              <div>
                <h2 class="h4 mb-1">Treaty participants</h2>

                <p class="geo-muted small mb-0">
                  Country participation recorded in Geo Link.
                </p>
              </div>

              <%# Count participant records, rather than unique countries. %>
              <span class="badge rounded-pill geo-badge">
                <%= pluralize(@treaty_participants.size, "participant") %>
              </span>
            </div>

            <%# Allow horizontal scrolling if needed on smaller screens. %>
            <div class="table-responsive">
              <table class="table geo-table align-middle mb-0">
                <caption class="visually-hidden">
                  Countries participating in treaties.
                </caption>

                <thead>
                  <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Treaty</th>
                    <th scope="col">Country</th>
                  </tr>
                </thead>

                <tbody>
                  <%# Display names from the associated treaty and country. %>
                  <% @treaty_participants.each do |participant| %>
                    <tr>
                      <td><%= participant.id %></td>

                      <th scope="row" class="py-3 fw-semibold">
                        <%= participant.treaty.name %>
                      </th>

                      <td><%= participant.country.name %></td>
                    </tr>
                  <% end %>

                  <%# Show an empty state before participants are added. %>
                  <% if @treaty_participants.empty? %>
                    <tr>
                      <td colspan="3" class="text-center py-5">
                        No participants yet. Add the first using the form.
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>
</div>