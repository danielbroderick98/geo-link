<div class="geo-home min-vh-100">
  <main class="container py-5">
    <div class="mb-4">
      <%= link_to "← Back to countries",
          admin_countries_path,
          class: "geo-accent text-decoration-none small" %>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-7 col-xl-6">
        <section class="card geo-card rounded-4">
          <div class="card-body p-4">
            <p class="geo-accent small fw-bold text-uppercase mb-2">
              Country management
            </p>

            <h1 class="h3 mb-2">Edit country</h1>

            <p class="geo-muted mb-4">
              Update the country's details below.
            </p>

            <%= render "form", country: @country %>
          </div>
        </section>
      </div>
    </div>
  </main>
</div>