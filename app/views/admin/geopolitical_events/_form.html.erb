<%# Display validation errors while preserving the entered details. %>
<% if geopolitical_event.errors.any? %>
<div class="alert alert-danger" role="alert">
    <p class="fw-semibold mb-2">Please check the following:</p>

    <ul class="mb-0">
    <% geopolitical_event.errors.full_messages.each do |message| %>
        <li><%= message %></li>
    <% end %>
    </ul>
</div>
<% end %>

<%# Use the same form for creating and updating events. %>
<%= form_with model: [:admin, geopolitical_event] do |form| %>
<div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title,
        class: "form-control geo-input",
        placeholder: "Enter the event title",
        required: true %>
</div>

<div class="mb-3">
    <%= form.label :event_type, "Event type", class: "form-label" %>
    <%= form.text_field :event_type,
        class: "form-control geo-input",
        placeholder: "e.g. Election, conflict, or treaty",
        required: true %>
</div>

<div class="mb-3">
    <%= form.label :started_on, "Started on", class: "form-label" %>
    <%= form.date_field :started_on,
        class: "form-control geo-input",
        required: true %>
</div>

<div class="mb-3">
    <%= form.label :ended_on, "Ended on", class: "form-label" %>
    <%= form.date_field :ended_on,
        class: "form-control geo-input",
        aria: { describedby: "event-end-date-help" } %>

    <p id="event-end-date-help" class="geo-muted small mt-2 mb-0">
    Leave blank if the event is ongoing.
    </p>
</div>

<div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description,
        class: "form-control geo-input",
        rows: 5,
        placeholder: "Describe the event",
        required: true %>
</div>

<%# Each checked country creates a link in event_countries. %>
<fieldset class="mb-4">
    <legend class="form-label fs-6">Countries involved</legend>

    <p class="geo-muted small">
    Select all countries involved in this event.
    </p>

    <%# Include every country so existing selections remain editable. %>
    <% countries = Country.order(:name) %>

    <% if countries.any? %>
    <%# The hidden field allows all country selections to be cleared. %>
    <%= form.collection_check_boxes :country_ids,
        countries, :id, :name do |country_field| %>
        <div class="form-check mb-2">
        <%= country_field.check_box class: "form-check-input" %>
        <%= country_field.label class: "form-check-label" %>
        </div>
    <% end %>
    <% else %>
    <p class="geo-muted small mb-0">
        Add countries in country management to make them available here.
    </p>
    <% end %>
</fieldset>

<%= form.submit(
        geopolitical_event.persisted? ? "Save changes" : "Add event",
        class: "btn geo-button w-100"
    ) %>
<% end %>