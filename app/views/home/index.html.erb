<div class="geo-home d-flex flex-column min-vh-100">
  <header class="container py-4">
    <nav class="d-flex justify-content-between align-items-center"
         aria-label="Main navigation">
      <a href="/" class="fs-3 fw-bold text-decoration-none text-light">
        Geo<span class="geo-accent">Link</span>
      </a>

      <span class="badge rounded-pill geo-badge px-3 py-2">
        Development underway
      </span>
    </nav>
  </header>

  <main class="container flex-grow-1 py-5">
    <div class="row align-items-center g-5 py-lg-5">
      <div class="col-lg-7">
        <p class="geo-accent small fw-bold text-uppercase">
          Welcome to Geo Link
        </p>

        <h1 class="display-3 fw-bold mb-4">
          A world of possibilities.<br>
          <span class="geo-accent">Connected.</span>
        </h1>

        <p class="lead geo-muted mb-4">
          A new connection starts here. We're building Geo Link,
          and this is just the beginning.
        </p>

        <a href="#project-status" class="btn geo-button btn-lg">
          Explore the project &rarr;
        </a>

        <%# Open the admin pages for managing countries and events. %>
        <div class="d-flex flex-wrap gap-3 mt-3">
          <%= link_to "Manage countries",
              admin_countries_path,
              class: "btn geo-button" %>

          <%= link_to "Manage geopolitical events",
              admin_geopolitical_events_path,
              class: "btn geo-button" %>
          
          <%# Open the diplomatic relationships management page. %>
          <%= link_to "Manage diplomatic relationships",
              admin_diplomatic_relationships_path,
              class: "btn geo-button" %>

          <%# Open the treaty management page using the existing Geo Link styling. %>
          <%= link_to "Manage treaties", admin_treaties_path,
            class: "btn geo-button" %>
        </div>
      </div>

      <div class="col-lg-5">
        <section id="project-status" class="card geo-card rounded-4">
          <div class="card-body p-4 p-lg-5">
            <span class="geo-accent small fw-semibold">
              Our first milestone
            </span>

            <h2 class="h3 mt-3 mb-3">Our foundation is ready.</h2>

            <p class="geo-muted mb-0">
              Ruby on Rails is running, our project is on GitHub,
              and Geo Link has its first Bootstrap homepage.
            </p>
          </div>
        </section>
      </div>
    </div>
  </main>

  <footer class="container">
    <div class="geo-footer py-4">
      <p class="small geo-muted mb-0">Geo Link · Built to connect.</p>
    </div>
  </footer>
</div>
