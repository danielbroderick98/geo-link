<%# Match the styling of the country directory. %>
<div class="geo-home min-vh-100">
  <header class="border-bottom border-secondary">
    <%# Display the shared navigation for all user pages. %>
    <%= render "user/shared/header" %>
  </header>

  <main class="container py-5">
    <div class="mb-4">
      <%= link_to "← Back to countries",
          user_countries_path,
          class: "geo-accent text-decoration-none small" %>
    </div>

    <%# Introduce the selected country. %>
    <div class="mb-4">
      <p class="geo-accent small fw-bold text-uppercase mb-2">
        Country profile
      </p>

      <h1 class="display-6 fw-bold">
        <%= @country.name %>
      </h1>

      <p class="geo-muted mb-0">
        Explore key information about <%= @country.name %>.
      </p>

      <% if @country.region.present? %>
        <span class="badge rounded-pill geo-badge px-3 py-2 mt-3">
          <%= @country.region %>
        </span>
      <% end %>
    </div>

    <section
      class="card geo-card rounded-4"
      aria-labelledby="country-details-heading"
    >
      <div class="card-body p-4">
        <h2 id="country-details-heading" class="h4 mb-4">
          Country details
        </h2>

        <%# Display saved country information as read-only values. %>
        <dl class="row mb-0">
          <dt class="col-sm-4 geo-muted">
            Country name
          </dt>

          <dd class="col-sm-8 mb-4">
            <%= @country.name %>
          </dd>

          <dt class="col-sm-4 geo-muted">
            Region
          </dt>

          <dd class="col-sm-8 mb-4">
            <%= @country.region.presence || "Not available" %>
          </dd>

          <dt class="col-sm-4 geo-muted">
            Capital
          </dt>

          <dd class="col-sm-8 mb-4">
            <%= @country.capital.presence || "Not available" %>
          </dd>

          <dt class="col-sm-4 geo-muted">
            Population
          </dt>

          <dd class="col-sm-8 mb-4">
            <% if @country.population.present? %>
              <%= number_with_delimiter(@country.population) %>
            <% else %>
              Not available
            <% end %>
          </dd>

          <dt class="col-sm-4 geo-muted">
            Political system
          </dt>

          <dd class="col-sm-8 mb-4">
            <%= @country.political_system.presence || "Not available" %>
          </dd>

          <dt class="col-sm-4 geo-muted">
            Status
          </dt>

          <dd class="col-sm-8 mb-0">
            <%# Show the saved active flag so the public profile agrees with country management. %>
            <% if @country.active? %>
              <span class="badge rounded-pill geo-badge">
                Active
              </span>
            <% else %>
              <span class="badge rounded-pill bg-secondary text-white">
                Inactive
              </span>
            <% end %>
          </dd>
        </dl>
      </div>
    </section>

    <section
      id="country-timeline"
      class="card geo-card rounded-4 mt-4"
      aria-labelledby="country-timeline-heading"
    >
      <div class="card-body p-4">
        <h2 id="country-timeline-heading" class="h4 mb-4">
          Country timeline
        </h2>

        <%# Explain an empty timeline when no linked records have usable dates. %>
        <% if @timeline.empty? %>
          <p class="geo-muted mb-0">There are no timeline entries for this country yet.</p>
        <% else %>
          <ul class="list-unstyled mb-0">
            <% @timeline.each do |entry| %>
              <li class="mb-2">
                <time class="geo-muted me-2" datetime="<%= entry.date.iso8601 %>">
                  <%= entry.date.strftime("%d %b %Y") %>
                </time>

                <%# Each record type has its own public detail page. %>
                <% if entry.type == :treaty %>
                  <%= link_to entry.title, user_treaty_path(entry.record_id), class: "geo-accent" %>
                <% else %>
                  <%= link_to entry.title, user_geopolitical_event_path(entry.record_id), class: "geo-accent" %>
                <% end %>

                <%# The library carries the event's ongoing status into the entry. %>
                <% if entry.ongoing %>
                  <span class="badge rounded-pill geo-badge">Ongoing</span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </section>
  </main>
</div>