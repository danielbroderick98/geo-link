<%# Match the styling of the country directory. %>
<div class="geo-home min-vh-100">
  <header class="border-bottom border-secondary">
    <nav
      class="container py-4 d-flex flex-wrap justify-content-between align-items-center gap-3"
      aria-label="Main navigation"
    >
      <%= link_to root_path,
          class: "fs-3 fw-bold text-decoration-none text-light" do %>
        Geo<span class="geo-accent">Link</span>
      <% end %>

      <%= link_to "Countries",
          user_countries_path,
          class: "geo-accent text-decoration-none" %>
    </nav>
  </header>

  <main class="container py-5">
    <div class="mb-4">
      <%= link_to "← Back to countries",
          user_countries_path,
          class: "geo-accent text-decoration-none small" %>
    </div>

    <%# Introduce the selected country. %>
    <div class="mb-4">
      <p class="geo-accent small fw-bold text-uppercase mb-2">
        Country profile
      </p>

      <h1 class="display-6 fw-bold">
        <%= @country.name %>
      </h1>

      <p class="geo-muted mb-0">
        Explore key information about <%= @country.name %>.
      </p>

      <% if @country.region.present? %>
        <span class="badge rounded-pill geo-badge px-3 py-2 mt-3">
          <%= @country.region %>
        </span>
      <% end %>
    </div>

    <section
      class="card geo-card rounded-4"
      aria-labelledby="country-details-heading"
    >
      <div class="card-body p-4">
        <h2 id="country-details-heading" class="h4 mb-4">
          Country details
        </h2>

        <%# Display saved country information as read-only values. %>
        <dl class="row mb-0">
          <dt class="col-sm-4 geo-muted">
            Country name
          </dt>

          <dd class="col-sm-8 mb-4">
            <%= @country.name %>
          </dd>

          <dt class="col-sm-4 geo-muted">
            Region
          </dt>

          <dd class="col-sm-8 mb-4">
            <%= @country.region.presence || "Not available" %>
          </dd>

          <dt class="col-sm-4 geo-muted">
            Capital
          </dt>

          <dd class="col-sm-8 mb-4">
            <%= @country.capital.presence || "Not available" %>
          </dd>

          <dt class="col-sm-4 geo-muted">
            Population
          </dt>

          <dd class="col-sm-8 mb-4">
            <% if @country.population.present? %>
              <%= number_with_delimiter(@country.population) %>
            <% else %>
              Not available
            <% end %>
          </dd>

          <dt class="col-sm-4 geo-muted">
            Political system
          </dt>

          <dd class="col-sm-8 mb-4">
            <%= @country.political_system.presence || "Not available" %>
          </dd>

          <dt class="col-sm-4 geo-muted">
            Status
          </dt>

          <dd class="col-sm-8 mb-0">
            <%# Display the status set on the admin Countries page. %>
            <% if @country.active? %>
              <span class="badge rounded-pill geo-badge">
                Active
              </span>
            <% else %>
              <span class="badge rounded-pill bg-secondary text-white">
                Inactive
              </span>
            <% end %>
          </dd>
        </dl>
      </div>
    </section>
  </main>
</div>